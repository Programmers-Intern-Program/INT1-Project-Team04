# ── 배포 설정 (GitHub Actions DOT_ENV_PROD에 포함) ────────────────────────────
HOST=                          # Node A 공인 IP
SSH_KEY_B64=                   # base64 -w0 ~/.ssh/oracle-ssh.key
NPM_EMAIL=admin@example.com    # terraform.tfvars과 같도록
NPM_PASSWORD=                  # terraform.tfvars과 같도록
FE_DOMAIN=app.example.com
BE_DOMAIN=api.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# ── 앱 설정 (서버 docker compose .env) ────────────────────────────────────────
NODE_A_IP=                     # Node A 공인 IP (HOST와 동일)
GITHUB_ORG=your-github-org
TAG=latest

# PostgreSQL
PG_USER=appuser
PG_PASSWORD=

# Redis
REDIS_PASSWORD=

# Langfuse self-hosted
LANGFUSE_DOMAIN=langfuse.example.com
LANGFUSE_NEXTAUTH_SECRET=      # openssl rand -hex 32
LANGFUSE_SALT=                 # openssl rand -hex 32
LANGFUSE_SECRET_KEY=           # sk-lf-... (Langfuse UI → Settings → API Keys)
LANGFUSE_PUBLIC_KEY=           # pk-lf-... (Langfuse UI → Settings → API Keys)
LANGFUSE_ENCRYPTION_KEY=       # openssl rand -hex 32
# 백엔드 → Langfuse OTLP 인증 (pk:sk를 base64 인코딩)
# echo -n "${LANGFUSE_PUBLIC_KEY}:${LANGFUSE_SECRET_KEY}" | base64 -w0
LANGFUSE_AUTH_PROD=

# 백엔드 앱 URL / 쿠키
APP_FRONTEND_BASE_URL=
APP_AUTH_SESSION_COOKIE_NAME=
APP_AUTH_STATE_COOKIE_NAME=
APP_AUTH_SESSION_DAYS=
APP_AUTH_SECURE_COOKIES=

# Kakao OAuth
APP_OAUTH_KAKAO_CLIENT_ID=
APP_OAUTH_KAKAO_CLIENT_SECRET=
APP_OAUTH_KAKAO_REDIRECT_URI=

# Google OAuth
APP_OAUTH_GOOGLE_CLIENT_ID=
APP_OAUTH_GOOGLE_CLIENT_SECRET=
APP_OAUTH_GOOGLE_REDIRECT_URI=

# Discord OAuth
APP_OAUTH_DISCORD_CLIENT_ID=
APP_OAUTH_DISCORD_CLIENT_SECRET=
APP_OAUTH_DISCORD_REDIRECT_URI=

# Notification dispatch
APP_NOTIFICATION_MAX_ATTEMPTS=3
APP_NOTIFICATION_RETRY_DELAY_SECONDS=300
# Telegram endpoint connection deep link (backend only)
APP_NOTIFICATION_TELEGRAM_BOT_USERNAME=

# Google Vertex AI (인증 키는 GitHub Secret GOOGLE_CREDENTIALS_JSON으로 별도 관리)
# Settings → Secrets → Actions → New repository secret
# Name: GOOGLE_CREDENTIALS_JSON / Value: vertex-key.json 파일 내용 그대로 붙여넣기
GOOGLE_CLOUD_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash

# MCP (prod은 prod-mcp 컨테이너가 떠있으므로 기본 true)
MCP_ENABLED=true
MCP_SERVER_URL=http://prod-mcp:8090
MCP_TRANSPORT=sse
MCP_SSE_HOST=0.0.0.0
MCP_SSE_PORT=8090

# MCP public API keys
MOLIT_APT_TRADE_API_KEY=
MOLIT_APT_RENT_API_KEY=
MOLIT_OFFI_TRADE_API_KEY=
MOLIT_OFFI_RENT_API_KEY=
MOLIT_RH_RENT_API_KEY=
MOLIT_RH_TRADE_API_KEY=
MOLEG_LAW_INFO_API_KEY=
NA_BILL_INFO_API_KEY=
MOEF_PUBLIC_JOB_API_KEY=
KEIS_WORKNET_JOB_API_KEY=
PPS_G2B_BID_API_KEY=

# MCP notification providers
MCP_NOTIFICATION_EMAIL_ENABLED=false
MCP_NOTIFICATION_EMAIL_FROM=notify@example.com
MCP_NOTIFICATION_EMAIL_HOST=smtp.gmail.com
MCP_NOTIFICATION_EMAIL_PORT=587
MCP_NOTIFICATION_EMAIL_USERNAME=notify@example.com
MCP_NOTIFICATION_EMAIL_PASSWORD=
MCP_NOTIFICATION_EMAIL_SMTP_AUTH=true
MCP_NOTIFICATION_EMAIL_STARTTLS_ENABLE=true
MCP_NOTIFICATION_DISCORD_ENABLED=false
MCP_NOTIFICATION_DISCORD_BOT_TOKEN=
MCP_NOTIFICATION_DISCORD_API_BASE_URL=https://discord.com/api/v10
MCP_NOTIFICATION_DISCORD_BOT_INVITE_URL=
# true이면 배포 중 Telegram webhook도 https://${BE_DOMAIN}/api/notification-endpoints/telegram/webhook 으로 등록됩니다.
MCP_NOTIFICATION_TELEGRAM_ENABLED=false
MCP_NOTIFICATION_TELEGRAM_BOT_TOKEN=
MCP_NOTIFICATION_TELEGRAM_API_BASE_URL=https://api.telegram.org
